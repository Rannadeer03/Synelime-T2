{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x" 
    }
  },
  "routes": [
    { "src": "/api/.*", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}


